{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/contracts/ci-profile-v1.schema.json",
  "title": "Reusable CI profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "workflow",
    "runtime",
    "commands",
    "supply_chain",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "source_commit",
        "trigger",
        "runner",
        "timeout_minutes"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "trigger": { "const": "workflow_call" },
        "runner": { "type": "string", "minLength": 1 },
        "timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 60 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "version"],
      "properties": {
        "ecosystem": {
          "enum": ["python", "go", "node", "jvm-gradle", "terraform"]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!latest$)(?!stable$).+$"
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "supply_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions_pinned_to_full_sha",
        "checkout_persist_credentials",
        "permissions",
        "lockfile_required",
        "arbitrary_command_inputs"
      ],
      "properties": {
        "actions_pinned_to_full_sha": { "const": true },
        "checkout_persist_credentials": { "const": false },
        "permissions": { "const": "read-only" },
        "lockfile_required": { "type": "boolean" },
        "arbitrary_command_inputs": { "const": false }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_path",
        "static_findings",
        "exact_head_ci_run_url",
        "conclusion"
      ],
      "properties": {
        "fixture_path": { "type": "string", "minLength": 1 },
        "static_findings": { "const": 0 },
        "exact_head_ci_run_url": {
          "type": "string",
          "pattern": "^https://github.com/.+/actions/runs/[0-9]+$"
        },
        "conclusion": { "const": "success" }
      }
    }
  }
}

{
  "uid": "observability-stack",
  "title": "#25 Observability Stack",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active incident",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "observability_active_incident", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto"}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP requests by status",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "targets": [{"expr": "sum by (status) (rate(observability_http_requests_total[1m]))", "refId": "A", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request duration p95",
      "gridPos": {"h": 8, "w": 16, "x": 0, "y": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(observability_http_request_duration_seconds_bucket[1m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Incident lifecycle",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [{"expr": "sum by (event) (increase(observability_incident_events_total[15m]))", "refId": "A", "legendFormat": "{{event}}"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Correlated incident logs",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{service_name=\\\"observability-stack\\\"} |= \\\"incident.lifecycle\\\"",
          "refId": "A"
        }
      ],
      "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true}
    },
    {
      "id": 6,
      "type": "traces",
      "title": "Incident traces",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "tempo", "uid": "tempo"},
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "tempo"},
          "queryType": "traceql",
          "query": "{ resource.service.name = \\\"observability-stack\\\" }",
          "refId": "A"
        }
      ]
    }
  ]
}
